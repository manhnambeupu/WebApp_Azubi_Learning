generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  ESSAY
  IMAGE_ESSAY
  ORDERING
  MATCHING
}

enum SessionType {
  LESSON_VIEW
  QUIZ_ATTEMPT
}

enum ChatRole {
  USER
  AI
}

model User {
  id               String                @id @default(uuid()) @db.Uuid
  email            String                @unique
  password         String?
  fullName         String                @map("full_name")
  role             Role
  authProvider     String?               @map("auth_provider")
  providerId       String?               @map("provider_id")
  refreshTokenHash String?               @map("refresh_token_hash")
  failedLoginCount Int                   @default(0) @map("failed_login_count")
  lockedUntil      DateTime?             @map("locked_until")
  createdAt        DateTime              @default(now()) @map("created_at")
  lessonAttempts   LessonAttempt[]
  lessonAccesses   StudentLessonAccess[]
  activitySessions ActivitySession[]
  aiChatHistories  AiChatHistory[]

  @@unique([authProvider, providerId])
  @@map("users")
}

model Category {
  id      String   @id @default(uuid()) @db.Uuid
  name    String   @unique
  lessons Lesson[]

  @@map("categories")
}

model Lesson {
  id               String                @id @default(uuid()) @db.Uuid
  title            String
  summary          String
  contentMd        String                @map("content_md")
  imageUrl         String?               @map("image_url")
  isPrivate        Boolean               @default(false) @map("is_private")
  timeLimit        Int?                  @map("time_limit") // Thời gian làm bài tính bằng phút
  categoryId       String                @map("category_id") @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt @map("updated_at")
  category         Category              @relation(fields: [categoryId], references: [id])
  files            LessonFile[]
  questions        Question[]
  lessonAttempts   LessonAttempt[]
  studentAccesses  StudentLessonAccess[]
  activitySessions ActivitySession[]
  aiChatHistories  AiChatHistory[]

  @@map("lessons")
}

model LessonFile {
  id         String   @id @default(uuid()) @db.Uuid
  lessonId   String   @map("lesson_id") @db.Uuid
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_files")
}

model Question {
  id          String       @id @default(uuid()) @db.Uuid
  lessonId    String       @map("lesson_id") @db.Uuid
  text        String
  explanation String?
  imageUrl    String?      @map("image_url")
  isPrivate   Boolean      @default(false) @map("is_private")
  type        QuestionType @default(SINGLE_CHOICE)
  orderIndex  Int          @map("order_index")
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers     Answer[]
  submissions Submission[]

  @@map("questions")
}

model Answer {
  id          String       @id @default(uuid()) @db.Uuid
  questionId  String       @map("question_id") @db.Uuid
  text        String
  isCorrect   Boolean      @map("is_correct")
  explanation String?
  orderIndex  Int?         @map("order_index")
  matchText   String?      @map("match_text")
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@map("answers")
}

model LessonAttempt {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  lessonId      String       @map("lesson_id") @db.Uuid
  attemptNumber Int          @map("attempt_number")
  score         Float?
  correctCount  Float?       @map("correct_count")
  submittedAt   DateTime     @default(now()) @map("submitted_at")
  user          User         @relation(fields: [userId], references: [id])
  lesson        Lesson       @relation(fields: [lessonId], references: [id])
  submissions   Submission[]

  @@unique([userId, lessonId, attemptNumber])
  @@index([userId, lessonId, attemptNumber])
  @@map("lesson_attempts")
}

model Submission {
  id         String        @id @default(uuid()) @db.Uuid
  attemptId  String        @map("attempt_id") @db.Uuid
  questionId String        @map("question_id") @db.Uuid
  answerId   String        @map("answer_id") @db.Uuid
  orderIndex Int?          @map("order_index")
  matchText  String?       @map("match_text")
  isCorrect  Boolean       @map("is_correct")
  attempt    LessonAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     Answer        @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

model ActivitySession {
  id                    String      @id @default(uuid()) @db.Uuid
  userId                String      @map("user_id") @db.Uuid
  lessonId              String      @map("lesson_id") @db.Uuid
  startedAt             DateTime    @default(now()) @map("started_at")
  endedAt               DateTime?   @map("ended_at")
  lastHeartbeatAt       DateTime    @default(now()) @map("last_heartbeat_at")
  activeDurationSeconds Int         @default(0) @map("active_duration_seconds")
  idleDurationSeconds   Int         @default(0) @map("idle_duration_seconds")
  sessionType           SessionType @map("session_type")
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson                Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@index([lastHeartbeatAt])
  @@map("activity_sessions")
}

enum EmailDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model EmailCampaign {
  id              String             @id @default(uuid()) @db.Uuid
  subject         String
  totalRecipients Int                @map("total_recipients")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  
  logs            EmailDeliveryLog[]

  @@map("email_campaigns")
}

model EmailDeliveryLog {
  id              String              @id @default(uuid()) @db.Uuid
  campaignId      String              @map("campaign_id") @db.Uuid
  email           String
  status          EmailDeliveryStatus @default(PENDING)
  errorReason     String?             @db.Text @map("error_reason")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  campaign        EmailCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([email])
  @@map("email_delivery_logs")
}

model StudentLessonAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  lessonId  String   @map("lesson_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("student_lesson_access")
}

model AiChatHistory {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  lessonId  String   @map("lesson_id") @db.Uuid
  role      ChatRole
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([studentId, lessonId])
  @@index([createdAt])
  @@map("ai_chat_histories")
}
